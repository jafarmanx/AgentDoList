<% @page_title = "Create a new agent" %>

<% content_for :header do %>
  <div class="header__actions header__actions--start">
    <%= back_link_to "Agents", agents_path, "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
  </div>

  <h1 class="header__title"><%= @page_title %></h1>
<% end %>

<article class="panel panel--wide center txt-align-start">
  <%= form_with model: @agent, data: { controller: "form" }, html: { class: "flex flex-column gap" } do |form| %>
    <h2 class="txt-large margin-none"><%= @page_title %></h2>

    <%= render "form", form: form %>

    <%= form.button type: :submit, class: "btn btn--link center txt-medium" do %>
      <span>Create agent</span>
    <% end %>

    <%= link_to "Go back", agents_path, data: { form_target: "cancel" }, hidden: true %>
  <% end %>
</article>
