#!/usr/bin/env bash

# Broadcast a message to a configured chat webhook.
# Requires CHAT_WEBHOOK_URL to be set.
#
# Example usage: bin/broadcast_to_bc "Deployment complete"

if [ -n "$CHAT_WEBHOOK_URL" ]; then
  curl -s -d content="[CurioArch] ${1}" "$CHAT_WEBHOOK_URL"
else
  echo "WARNING: Chat broadcast not sent (CHAT_WEBHOOK_URL not set)."
fi
