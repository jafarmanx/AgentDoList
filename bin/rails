#!/usr/bin/env ruby
APP_PATH = File.expand_path("../config/application", __dir__)

require_relative "../lib/curio_arch"
CurioArch.configure_bundle

require_relative "../config/boot"

require "rails/commands"

if CurioArch.saas? && ENV["RAILS_ENV"] == "test"
  # the app is not loaded by rails/commands if there are additional arguments to "rails test"
  require APP_PATH
  CurioArch::Saas.append_test_paths
end
