#!/bin/sh

# Notify an external deployment dashboard after a deploy.
# Requires DEPLOY_NOTIFICATION_URL and DEPLOY_NOTIFICATION_AUTH to be set.
#
# Example usage: bin/notify_dash_of_deployment $MESSAGE $KAMAL_VERSION $KAMAL_PERFORMER $CURRENT_BRANCH $KAMAL_DESTINATION $KAMAL_RUNTIME

if [ -n "$DEPLOY_NOTIFICATION_URL" ] && [ -n "$DEPLOY_NOTIFICATION_AUTH" ]; then
  jq -n -c --arg message "${1}" \
    --arg commit "${2}" \
    --arg author "${3}" \
    --arg branch "${4}" \
    --arg env "${5}" \
    --arg duration "${6}" \
    '{
      "application":"curioarch",
      "rails_env": $env,
      "branch": $branch,
      "deployer": $author,
      "message": $message,
      "rev": $commit,
      "duration": $duration
      }' |
    curl --user "$DEPLOY_NOTIFICATION_AUTH" -H "Content-Type: application/json" --data-binary @- \
      "$DEPLOY_NOTIFICATION_URL"
else
  echo "WARNING: Deploy notification not sent (DEPLOY_NOTIFICATION_URL or DEPLOY_NOTIFICATION_AUTH not set)."
fi
